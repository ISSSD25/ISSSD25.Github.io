  custHotelsReq: function custHotelsReq(defObj) {
    var hotelResults = [];
    var max = window.Data.max === window.DEFAULTS.max ? 100000 : window.Data.max;
    var maxCounter = 0;

    // only if hotel filter is on to show
    if (window.Data.showHotels || window.Data.showAllAcc) {
      window.Data.hotels.forEach(function (aHotel) {
        var currency = aHotel.currency || window.DEFAULTS.currencyCode;
        var price = Math.round(aHotel.price / app_currency.data[currency]);
        var latLng = [aHotel.lat, aHotel.lng];
        var decodedUrl = decodeURIComponent(aHotel.url);
        var url = decodedUrl !== 'undefined' ? decodedUrl : '';

        // only push if it's between the price filters
        if (price >= window.Data.min && price <= max) {
          maxCounter += 1;

          // and is visible to map coords (seperate so we dont get zoomout bug)
          if (ui_default().isInBoundingBox(latLng, window.Data.neLatLng, window.Data.swLatLng)) {
            var nightly = price * window.Currency.rate;
            var total = price * window.Data.amtOfNights * window.Currency.rate;
            hotelResults.push({
              hid: "hid".concat("".concat(aHotel.lat).concat(aHotel.lng).replace(/\./g, '')),
              latLng: latLng,
              isInstantBook: !!aHotel.url,
              provider: 'chotels',
