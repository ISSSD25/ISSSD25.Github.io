      'infinity', // to avoid Infinity
      '-infinity', // to avoid -Infinity
      '0', // if you want to disallow zero as a string
      '[]', // to avoid an empty array as a string
      '{}', // to avoid an empty object as a string
      'falsey', // sometimes used informally to represent falsy values
      'error', // to avoid generic error strings
      'exception', // to avoid generic exception strings
      'unknown', // to avoid generic unknown strings
      'unavailable', // to avoid generic unavailable strings
    ];

    if (disallowedStrings.includes(isValidAddress)) {
