      window.Data.showAllAcc = false;
    }
    view.urlStateChange(helpers22_default().getURL({
      includeSettings: true,
      includeFilters: true,
      includeViewport: true
    }), true);
    view.refineSearch();
  },
  ratingChange: function ratingChange() {
    var $currentClick = $(this); // The star currently selected
    var ratingValue = Number($(this).data('value')); // the value of the current star

    var $clickParent = $currentClick.parent();
    var previousValue = $clickParent.find('.selected').data('value');
    $clickParent.find('.selected').removeClass('selected');
    $clickParent.find("[data-value='".concat(ratingValue, "']")).addClass('selected');

    // Assiging the right value to the right Data
    if ($clickParent.attr('id') === 'filter-stars') {
      if (window.Data.minStarRating && ratingValue === previousValue) {
        window.Data.minStarRating = undefined;
        $currentClick.removeClass('selected');
      } else {
        window.Data.minStarRating = ratingValue;
        window.Stay22.widgetTracker.triggerFilterEvent('hotelstars', {
          value: window.Data.minStarRating
        });
      }
    } else if ($clickParent.attr('id') === 'filter-ratings') {
      if (window.Data.minGuestRating && ratingValue === previousValue) {
        window.Data.minGuestRating = undefined;
        $currentClick.removeClass('selected');
      } else {
        window.Data.minGuestRating = ratingValue;
        window.Stay22.widgetTracker.triggerFilterEvent('reviewscore', {
          value: window.Data.minGuestRating
        });
      }
    }
    view.urlStateChange(helpers22_default().getURL({
      includeSettings: true,
      includeFilters: true,
      includeViewport: true
    }), true);
    view.refineSearch();
  },
