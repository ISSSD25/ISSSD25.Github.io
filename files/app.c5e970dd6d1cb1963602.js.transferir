  roomTypeChange: function roomTypeChange() {
    window.Data.showHotels = $('#bm-show-epo').is(':checked');
    window.Data.showAirbnbs = $('#bm-show-pr').is(':checked');
    window.Data.showOthers = $('#bm-show-sr').is(':checked');
    if (window.Data.showHotels && window.Data.showAirbnbs) {
      window.Data.roomtype = 'all';
    } else if (window.Data.showHotels) {
      window.Data.roomtype = 'hotels';
    } else if (window.Data.showAirbnbs) {
      window.Data.roomtype = 'rentals';
    } else {
      window.Data.roomtype = 'none';
    }
    window.Stay22.widgetTracker.triggerFilterEvent('roomtype', {
      value: window.Data.roomtype
    });
    if (!window.Data.showHotels && !window.Data.showAirbnbs && !window.Data.showOthers) {
      // Data.showHotels = true;
      // Data.showAirbnbs = true;
      // Data.showOthers = true;

      window.Data.showAllAcc = true;
