  instantiatePOIMarker: function instantiatePOIMarker(aPOI) {
    var marker = maplibregl_Map.addPoiMarker(aPOI);
    var pinInfo = {
      marker: marker,
      info: aPOI
    };
    var markerElement = marker.getElement();
    markerElement.addEventListener('mouseover', function (e) {
      return onPoiMouseOver(e, pinInfo);
    });
    markerElement.addEventListener('mouseout', function (e) {
      return onPoiMouseOut(e, pinInfo);
    });
    markerElement.addEventListener('click', function (e) {
      return onPoiClick(e, pinInfo);
    });
    return pinInfo;
  },
  renderMenuPOI: function renderMenuPOI(aPOI) {
    var $poiList = $('#poiList');
    if ($poiList.length) {
      $poiList.append(this.poiMenuTmpl(aPOI));
      //@ts-ignore
      $poiList[0].scrollTop = $poiList.height() + 350;
    }
  },
  hasPOIs: function hasPOIs() {
    return this.poiMarkers.length;
  },
