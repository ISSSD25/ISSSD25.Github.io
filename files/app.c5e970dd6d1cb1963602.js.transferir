    var airCoThenTLD = ['.cr', '.id', '.in', '.kr', '.nz', '.uk', '.ve'];
    var airComThenTLD = ['.ar', '.au', '.bo', '.br', '.bz', '.co', '.ec', '.gt', '.hk', '.hn', '.mt', '.my', '.ni', '.pa', '.pe', '.py', '.sg', '.sv', '.tr', '.tw'];
    if (airTLD.indexOf(aTLD) !== -1) {
      return aTLD;
    } else if (airCoThenTLD.indexOf(aTLD) !== -1) {
      return '.co' + aTLD;
    } else if (airComThenTLD.indexOf(aTLD) !== -1) {
      return '.com' + aTLD;
