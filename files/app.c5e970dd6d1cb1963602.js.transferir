    $('.gp-plusminus').click(function (e) {
      var $target = $(e.currentTarget);
      var cmd = $target.data('cmd');
      var $input;
      var value;
      if (cmd === 'minus') {
        $input = $target.next();
        value = Number($input.val());
        if (value > Number($input.attr('min'))) {
          $input.val(value - 1);
        }
      } else {
        $input = $target.prev();
        value = Number($input.val());
        if (value < Number($input.attr('max'))) {
          $input.val(value + 1);
        }
      }
      $input.trigger('change');
    });
