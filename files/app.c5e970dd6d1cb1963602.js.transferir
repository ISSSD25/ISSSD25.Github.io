  renderHeartsRating: function renderHeartsRating(rating) {
    var heart = '';
    for (var i = 0; i < rating && rating - i >= 1; i++) {
      heart += '<i class="fa fa-heart"></i> ';
    }
    if (rating >= 4.75 && rating < 5) {
      // give it another heart might aswell
      heart += '<i class="fa fa-heart"></i>';
    } else if (rating % 1 >= 0.5) {
      heart += '<i class="fa fa-heart half"></i>';
    }
    return heart;
  },
  getRatingColor: function getRatingColor(rating) {
    var color = '';
    if (rating >= 3.5) {
      color = 'badge-turquoise';
    } else if (rating >= 3) {
      color = 'badge-yellow';
    } else {
      color = 'badge-red';
    }
    return color;
  },
