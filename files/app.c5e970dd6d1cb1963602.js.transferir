  }, window.DEFAULTS.hcPoolingTO),
  hotelscombinedReq: function hotelscombinedReq(defObj, grdOverwrite, apiName) {
    grdOverwrite = grdOverwrite || {};
    // @ts-ignore
    $.ajax({
      url: "/api/".concat(apiName),
      dataType: 'jsonp',
      queryType: ['listings', apiName],
      data: this.getRequestData(grdOverwrite)
    }).done(function (data) {
      if (window.Data.defaultHotelsAPI === data.provider) {
        // insert fresh pins for the default API, the other just updates
        // @ts-ignore
        view.processListings(data);
      }
      if (data.isComplete) {
        if (data.provider === 'hotelscombined' || data.provider === 'trivago' || data.provider === 'tripadvisor') {
          app_currency.updateWithHCPricing(data);
        } else if (data.provider === 'booking') {
          // Currency.updateWithBKPricing(data);
        }
      }
    }).fail(function (jqXHR) {
      // Only if it's not cancelled
      if (jqXHR.status || jqXHR.statusText === 'timeout') {
        console.log("Request to /api/".concat(apiName, " has failed due to '").concat(jqXHR.statusText, "'"));
      }
    }).always(function (data) {
      // have to check for status in case cancelled
      if (data.status && data.results && data.results.length) {
        // resolve it as soon as u got results to stop loading spinner
        defObj.resolve(data);
      }

      // now check if we need to keep polling or we good
      if (data.status >= 400) {
        defObj.resolve({
          amtOfResults: 0
        });
      } else if (data.isComplete) {
        // fully complete
        defObj.resolve(data);
      } else if (data.status && window.Data.invMode === 'accommodation') {
        Accommodation.pollingHC(defObj, apiName, data.pollData);
      }
    });
  },
  discountHotelsReq: function discountHotelsReq(defObj) {
