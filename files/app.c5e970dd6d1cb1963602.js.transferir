      data: this.getRequestData()
    }).done(function (data) {
      // Data.meta = data.meta;
      // processListings(data);
    }).fail(function (jqXHR) {
      // Only if it's not cancelled
      if (jqXHR.status || jqXHR.statusText === 'timeout') {
        extras.devLog("external api failed ".concat(jqXHR.statusText));
      }
    }).always(function (data) {
      if (data.status === 200) {
        defObj.resolve(data);
      } else {
        defObj.resolve({
          amtOfResults: 0
        });
      }
    });
  },
