    var absoluteMinUSD = priceRange.absoluteMinUSD * multiple;
    var absoluteMaxUSD = priceRange.absoluteMaxUSD * multiple;
    var absoluteMin = Math.round(absoluteMinUSD * rate);
    var absoluteMax = Math.round(absoluteMaxUSD * rate);
    var step = Math.round(absoluteMax / 100);
    priceRange.minUSD = minUSD;
    priceRange.maxUSD = maxUSD;
