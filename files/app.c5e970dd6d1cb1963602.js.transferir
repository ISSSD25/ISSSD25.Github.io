        // put the HC algo back to s22default.. for now use HC default
        // in case they gforce HC, do the same when reverting back but if it's hotelscombined
        if (acsHotel.info.provider === 'hotelscombined' && currency_Data.defaultHotelsAPI === 'booking') {
