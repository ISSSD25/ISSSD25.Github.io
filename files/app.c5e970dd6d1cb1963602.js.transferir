  getCurrentHcURL: function getCurrentHcURL(data, appendAid) {
    appendAid = appendAid || '**rlsearch';
    var params = {};
    var destination = {};
    try {
      // There is a way to bring in the viewport
      // but when they land for the back button, it looks fuckey sice only 5 resutls
      // no mapview next to it makes it sketch

      // deleted genHCPolygon string so if you want to use back this fn holla at me
      // var destination = this.genHCPolygonStr(
      //   window.Geocoder.genPolygon(Data.neLatLng, Data.swLatLng)
      // );

      params = {
        destination: destination,
        checkin: data.checkIn ? external_moment_default()(data.checkIn, DEFAULTS.dtFormat).format('YYYY-MM-DD') : '',
        checkout: data.checkOut ? external_moment_default()(data.checkOut, DEFAULTS.dtFormat).format('YYYY-MM-DD') : '',
        // currencyCode: Currency.code,
        // languageCode: Data.langShort,
        a_aid: '159552',
        label: data.aid + appendAid
      };
    } catch (e) {
      // do notihng (in case no poly?) report this error
      if (window.Stay22.widgetTracker) {
        window.Stay22.widgetTracker.mixpanel.track('error-nopoly');
      }
    }
    return '//www.hotelscombined.com/Hotels/Search?' + $.param(params);
  },
  encodeCity: function encodeCity(uri) {
    return uri.replace(/\//g, '-').replace(/(:|@|#|;|\.)/g, '').replace(/-/g, '~').replace(/, /g, '--').replace(/ /g, '-').replace(/-~-/g, '--');
  },
  isRetina: function isRetina() {
    return window.devicePixelRatio > 1;
  },
  getEventStatus: function getEventStatus(startDate, endDate, timezone) {
    var currentDate = external_moment_default()().utcOffset(timezone);
    if (currentDate.isAfter(endDate)) {
      // We're past that
      return 'finished';
    } else if (currentDate.isBefore(startDate)) {
      // Upcoming
      return 'upcoming';
    }
    // On going
    return 'ongoing';
  },
  inIframe: function inIframe() {
    try {
      return window.self !== window.top;
    } catch (e) {
      return true;
    }
  },
  toCSV: function toCSV(obj, separator) {
    var arr = [];
    for (var key in obj) {
      if (obj.hasOwnProperty(key)) {
        arr.push('"' + obj[key] + '"');
      }
    }
    return arr.join(separator || ',');
  },
