    // en-us en US: ".com"
    // es es IN: ".com"
    // fi fi IN: ".com"
    // fi fi FI: ".fi"
    // fi fi DK: ".com"
    // da da DK: ".dk"
    // da da BR: ".com"
    // pt pt BR: ".com.br"
    // pt-br pt BR: ".com.br"
    // da da CA: ".com"
    // en-us en CA: ".ca"
    // en en CA: ".ca"
    // en-ca en CA: ".ca"
    // en-gb en CA: ".ca" -> ".com" (i dont give a fuck, since they're in CA)
    // fr fr CA: ".ca"
    // fr-ca fr CA: ".ca"

    // bnb caveat
    if (fullLang === 'en-us') {
      fullLang = 'en';
    }

    // if full lang is 4 chars
    if (fullLang.includes('-')) {
      flCC = "".concat(shortLang, "-").concat(countryCode);
      tld = findAirTLD(flCC);

      // edge case of pt-br pt BR --> use only "pt" to find it, since me list is not exaus
      if (!tld && matchFL2withCC("".concat(shortLang, ":").concat(countryCode))) {
        tld = findAirTLD(shortLang);
      }
    } else {
      // the full lang is 2 chars, so find it exact
      flCC = "".concat(fullLang, "-").concat(countryCode);
      tld = findAirTLD(flCC);

      // only if it's part of the short list
      if (!tld && matchFL2withCC("".concat(shortLang, ":").concat(countryCode))) {
        tld = findAirTLD(fullLang);
      }
    }
    if (!tld) {
      tld = '.com';
    }

    // @ts-ignore
    this.airTLD = tld;
    return tld;
