  accommodationReq: function accommodationReq() {
    var hotelsDef = $.Deferred();
    var hotelsDef2 = $.Deferred();
    var rentalsDef = $.Deferred();
    var custHotelsDef = $.Deferred();
    var directHotelsDef = $.Deferred();
    var discountHotelsDef = $.Deferred();

    // Show loading spinner for everyone except CH/DH
    if (window.Data.hasOnlyChotels || window.Data.hasOnlyDhotels) {
      // after intial load, it's cached no need to spin
      if (!window.Data.hasTakenOver) {
        view.toggleLoading('show');
        view.hideNoResultsPop();
      }
    } else {
      view.toggleLoading('show');
      view.hideNoResultsPop();

      // this is so HC doesnt bug out with infinite loader when they slow
      this.loaderCancelDeb();
    }
    if (!window.Data.disableHotels) {
      // FOR BOTH HOTELS REQUEST MIXING EACH OTHER
      // $.xhrPool.abort('hotelscombined');
      // hotelscombinedReq(hotelsDef, {}, 'hotelscombined');

      // $.xhrPool.abort('booking');
      // hotelscombinedReq(hotelsDef2, {}, 'booking');

      // FOR DISCOUNTS
      // if (
      //   !window.Data.externalAPI &&
      //   !window.Data.disableDiscounts &&
      //   !$.xhrPool.find('discounts22') &&
      //   window.Data.defaultHotelsAPI !== 'hotelscombined' &&
      //   !window.Data.isStatic &&
      //   window.Data.checkIn &&
      //   window.Data.checkOut
      // ) {
      //   discountHotelsReq(discountHotelsDef);
      // }

      // FOR ONLY ONE
      // @ts-ignore
      $.xhrPool.abort(window.Data.defaultHotelsAPI);
      this.hotelscombinedReq(hotelsDef, {}, window.Data.defaultHotelsAPI);
      hotelsDef2.resolve({
        amtOfResults: 0
      });
    } else {
      hotelsDef.resolve({
        amtOfResults: 0
      });
      hotelsDef2.resolve({
        amtOfResults: 0
      });
      discountHotelsDef.resolve({
        amtOfResults: 0
      });
    }
    if (accommodation_Data.defaultRentalsAPI && !window.Data.disableRentals) {
      // @ts-ignore
      $.xhrPool.abort(accommodation_Data.defaultRentalsAPI);
      this.airbnbReq(rentalsDef);
    } else {
      rentalsDef.resolve({
        amtOfResults: 0
      });
    }
    if (window.Data.hasCustomHotels) {
      this.custHotelsReq(custHotelsDef);
    } else {
      custHotelsDef.resolve({
        amtOfResults: 0
      });
    }
    if (window.Data.externalAPI) {
      // @ts-ignore
      $.xhrPool.abort('dhotels');
      this.directHotelsReq(directHotelsDef);
    } else {
      directHotelsDef.resolve({
        amtOfResults: 0
      });
    }

    // when discounts and HC is done
    // $.when(hotelsDef, discountHotelsDef).then((hData, d22Data) => {
    //   if (d22Data.amtOfResults && window.Data.defaultHotelsAPI === 'booking') {
    //     Currency.insertDiscounts(d22Data);
    //   }
    // });

    $.when(hotelsDef, hotelsDef2, rentalsDef, custHotelsDef, directHotelsDef).then(function (hData, hData2, rData, chData, dhData) {
      var totalAcc;
      var minNeeded;
      window.Data.currentVisibleCount = hData.amtOfResults + hData2.amtOfResults + rData.amtOfResults + chData.amtOfResults + dhData.amtOfResults;
      var hasReturnedSomething = !!hData.status || !!hData2.amtOfResults || !!rData.status || !!chData.status || !!dhData.status;

      // bugs out if we zoomout too much
      // so just fucking kill it idgaf
      // https://static.stay22.com/events/gm?address=madison%20square%20garden
      // update: useless didnt fix thep roblem
      // if (window.Data.isStatic) {
      //   window.Data.hasTakenOver = true;
      //   return;
      // }

      // Only do the zoom out on load
      if (!window.Data.hasTakenOver && !window.Data.hasRefinedOnce) {
        // Has to show everything for chotels
        if (window.Data.hasCustomHotels) {
          totalAcc = chData.results.length;
          minNeeded = window.Data.hasRefinedOnce ? 1 : chData.amtOfResults;
        } else if (window.Data.showHotels || window.Data.showAllAcc) {
          // force bks to show at least 2, since jul 27
          // meaning do not include rentals in the totalACc
          totalAcc = hData.amtOfResults + hData2.amtOfResults + dhData.amtOfResults + rData.amtOfResults;
          // added airbnb in the count too as of feb 10
          minNeeded = 2;
        } else {
          totalAcc = hData.amtOfResults + hData2.amtOfResults + rData.amtOfResults + dhData.amtOfResults;
          minNeeded = 4;
        }

        // Only zoomout if needs more pins and if there's space
        if (!window.Data.disableZoomOutTS && totalAcc < minNeeded && maplibregl_Map.getInstance().getZoom() > window.DEFAULTS.minAppropriateZoom) {
          //Continue Zooming out
          maplibregl_Map.setZoom(1, ZoomDirection.OUT);
        } else {
          view.toggleLoading('hide');
          if (!window.Data.currentVisibleCount && hasReturnedSomething) {
            view.showNoResultsPop();
          }

          // cancelling this for now cuz of costs going to mapbox
          // and cuz PSD team got complaints from partners
          // if (
          //   !window.Data.hasRefinedOnce &&
          //   !window.Data.disableAutoHover &&
          //   window.Stay22.$window.width() >= 320 &&
          //   window.Stay22.$window.height() >= 299
          // ) {
          //   View.autoLoadHover();
          // }

          // We're guc now
          window.Data.hasTakenOver = true;
        }
      } else {
        view.toggleLoading('hide');
        if (!window.Data.currentVisibleCount && hasReturnedSomething) {
          view.showNoResultsPop();
        }
      }
    });
  },
  pollingHC: external_default().debounce(function (defObj, apiName, pollData) {
    // due to polling timing quirk, gotta check if we're still the proper invMode
    // @ts-ignore
    if (!$.xhrPool.find(apiName) && window.Data.invMode === 'accommodation') {
      Accommodation.hotelscombinedReq(defObj, {
