      return false;
    }

    // this removes %20 stuff
    let cleanAddr = unescape(address).trim().toLocaleLowerCase();

    // this removes &amp; stuff
    // strict because we dont want &amp -> &, it needs semicolon to really mean it
    cleanAddr = htmlEntity.decode(cleanAddr, { scope: 'strict' });

    // remove boxes �, it's not a space trust
    cleanAddr = cleanAddr.replace(//g, '');

    // swap ʻ to ' (ʻokina)
    cleanAddr = cleanAddr.replace(/ʻ/g, "'");

    // this is used to only to clean up
    // for some reason doesnt work with % and $ as it transforms it to "dollar percentage"
    const isValidAddress = slugify(cleanAddr, {
