      // Raise Pin Above all Pins
      pin.marker._element.style.zIndex = MarkerZIndex.HOVERED_PIN.toString();

      // Add Rental/Hotel Background color class to hoverCard
      var marker = $(pin.marker.getElement());
      marker.children().addClass("".concat(pin.info.type || pin.info.provider, "-hov"));
    }
  },
