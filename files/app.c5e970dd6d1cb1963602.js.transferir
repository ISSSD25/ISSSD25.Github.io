          // update the polling main && rates as usual
          acsHotel.info.prices = aHotel.prices;
          acsHotel.info.data.rates = aHotel.data.rates;

          // update hotel provider logo
          acsHotel.info.data.logo = aHotel.data.logo;

          // give a direct url too
          acsHotel.info.data.urlDirect = aHotel.data.urlDirect;
        }

        // overwrite for bk to be first thumb
        acsHotel.info.data.thumb = aHotel.data.thumb;

        // rooms left bagaye
        acsHotel.info.data.availableRooms = aHotel.data.availableRooms;

        // BOTH FIGHTING EACH OTHER

        // whoever is advertising cancellation, take it
        if (aHotel.data.hasFreeCancellation) {
          acsHotel.info.data.hasFreeCancellation = aHotel.data.hasFreeCancellation;
        }

        // take the best review score, review amount, and stars
        if (Number(aHotel.data.rating) > Number(acsHotel.info.data.rating)) {
          acsHotel.info.data.rating = aHotel.data.rating;
        }
        if (Number(aHotel.data.ratingOn10) > Number(acsHotel.info.data.ratingOn10)) {
          acsHotel.info.data.ratingOn10 = aHotel.data.ratingOn10;
        }
        if (Number(aHotel.data.reviewCount) > Number(acsHotel.info.data.reviewCount)) {
          acsHotel.info.data.reviewCount = aHotel.data.reviewCount;
        }
        if (Number(aHotel.data.stars) > Number(acsHotel.info.data.stars)) {
          acsHotel.info.data.stars = aHotel.data.stars;
        }

        // re-render the price, using DEFERs
