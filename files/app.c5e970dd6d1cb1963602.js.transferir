const _ = __webpack_require__(22224);

const helpers = {
  getURL: function(options, data) {
    options = options || {};
    data = data || window.Data;

    var queryObj = {};
    var qs = '';
    var canonical = options.canonical || data.canonical;

    if (options.includeSettings) {
      _.extend(queryObj, data.initalSettingsObj);
    }

    if (options.includeFilters) {
      _.extend(queryObj, this.genFiltersObj(data));
    } else if (options.includeFilters === false) {
      // hard false, not just undefined meaning u really mean it
      queryObj = _.omit(queryObj, Object.keys(this.genFiltersObj(data)));
    }

    if (options.includeViewport) {
      _.extend(queryObj, this.genViewportObj(data));
    } else if (options.includeViewport === false) {
      // hard false, not just undefined meaning u really mean it
      queryObj = _.omit(queryObj, Object.keys(this.genViewportObj(data)));
    }

    ////// OVERWRITE STUFF ///////

    // force lang
    if (options.ljs) {
      queryObj.ljs = options.ljs;

      // this is to prevent infinite loop of prompting settings when changed lang
      if (queryObj.openmenu === 'settings') {
        queryObj.openmenu = undefined;
      }
    }

    // force curr
    if (options.currency) {
      queryObj.currency = options.currency;

      // this is to prevent infinite loop of prompting settings when changed curr
      if (queryObj.openmenu === 'settings') {
        queryObj.openmenu = undefined;
      }
    }

    // force ppn
    if (options.pricePer) {
      queryObj.priceper = options.pricePer;

      // this is to prevent infinite loop of prompting settings when changed pp
      if (queryObj.priceper === 'settings') {
        queryObj.priceper = undefined;
      }
    }

    // force aid rewrite
    if (options.aid) {
      queryObj.aid = options.aid;
    }

    // add discounts if not set and force show all
    if (options.addRDiscounts) {
      queryObj.externalapi = 'realdiscounts';
      queryObj.disablehotels = 'false';
      queryObj.disablerentals = 'false';
    }

    // // hidenavbar for your embed on force
    // if (options.hideNavbar) {
    //   queryObj.hidenavbar = true;
    // }
    // no longer supporting hide navbar

    // showSearchBar forced to false
    if (options.showSearchBar === false) {
      queryObj.showsearchbar = options.showSearchBar;
    }

    if (options.forceParams) {
      _.extend(queryObj, options.forceParams);
    }

    // for ppl who forget
    if (queryObj.promptembed) {
      delete queryObj.promptembed;
    }

    // reste dans /embed for changing lang
    if (options.isSameTab) {
      canonical = canonical.replace('events', 'embed');
    }

    qs = $.param(queryObj);

    if (qs) {
      qs = '?' + qs;
    }

    return canonical + qs;
  },

  genFiltersObj: function(data) {
    var queryObj = {};

    if (data.checkIn && data.checkOut) {
      queryObj.checkin = data.checkIn;
      queryObj.checkout = data.checkOut;
    }

    queryObj.adults = data.adults;
    queryObj.children = data.children;
    queryObj.infants = data.infants;
    queryObj.rooms = data.rooms;
    queryObj.bedrooms = data.bedrooms;
    queryObj.beds = data.beds;
    queryObj.bathrooms = data.bathrooms;

    queryObj.minstarrating = data.minStarRating;
    queryObj.minguestrating = data.minGuestRating;

    queryObj.min = data.min;
    queryObj.max = data.max;

    queryObj.showhotels = data.showHotels;
    queryObj.showairbnbs = data.showAirbnbs;
    queryObj.showothers = data.showOthers;
    
    queryObj.invmode = data.invMode;

    return queryObj;
  },

  genViewportObj: function(data) {
    var queryObj = {};

    if (data.neLatLng) {
      queryObj.nelat = data.neLatLng[0];
      queryObj.nelng = data.neLatLng[1];
      queryObj.swlat = data.swLatLng[0];
      queryObj.swlng = data.swLatLng[1];

      // if this causes trouble, you need to delete it on getURL so it doesnt overwrite from initsettings
      queryObj.zoom = data.zoom;
    }

    return queryObj;
  }
};

module.exports = helpers;


