  getUserAirTLD: function getUserAirTLD(options) {
    if (this.localTLD) {
      return {
        localTLD: this.localTLD,
        needsLocal: this.needsLocal,
        needsCom: this.needsCom
      };
    }
    var lang = options.lang.toLowerCase();
    var userLangShort = options.userLangShort.toLowerCase();
    var countryCode = options.countryCode.toLowerCase();
    if (options.officialLang.indexOf(userLangShort) >= 0) {
      // weird case where u need country to back it up for en
      // doesnt work with US, so keep loading locale for that
      if (lang.length >= 3 && userLangShort === 'en' && lang.indexOf('us') === -1) {
        // big ass lang, check if country matches now
        if (lang.indexOf(countryCode) >= 0) {
          // local enligsh, u can load
          this.needsLocal = true;
        } else {
          // do nothing, you need to load .com (busted en/uc)
          this.needsCom = true;

          // load LL just in case and track it bcuz he still has a chance to go there
          // TREM
          // this.needsLocal = true;
          // granularAID = '*jic';
        }
      } else {
        // local lang and uc
        this.needsLocal = true;
      }
    } else {
      // do nothing, if user's lang is not a official lang of UC, then load .com
      this.needsCom = true;

      // Stills if the user has some LL to load, just load it for now
      // TREM
      // this.needsLocal = true;
      // granularAID = '*jic';
    }
    if (this.needsLocal) {
      // @ts-ignore
      this.localTLD = this.getAirTLD(Data.userTLD);
      if (this.localTLD) {
        // we can go ahead and confirm it will load local as LTLD exists
        this.needsLocal = true;
      } else {
        // if an local airTLD doesn't exist, fallback to .com, but never both
        this.needsLocal = false;
        this.needsCom = true;
      }
    } else {
      // if it doesn't need local, then it must need .com
      this.needsCom = true;
    }
    if (!this.localTLD) {
      // @ts-ignore
      this.localTLD = '.com';
    }
    return {
      localTLD: this.localTLD,
      needsLocal: this.needsLocal,
      needsCom: this.needsCom
    };
