      hasJS: false,
      disableeta: false,
      disablehover: false,
      hasCustomImg: false,
      hasEmptyInfo: false,
      hideFromMenu: false
    };
    this.poiMarkers.push(this.instantiatePOIMarker(aPOI));
    this.renderMenuPOI(aPOI);

    // select it so the map moves to the thing
    var selectedPOI = this.selectPOI(this.cIndex);

    // recache all the pin nodes for opaques
    poi_Stay22.Cache.$mmToOpaque = $('.mm-toopaque-active');
    view.centerMap(selectedPOI.latLng, undefined, CenterMapMethod.FLYTO);
    this.cIndex++;
  },
