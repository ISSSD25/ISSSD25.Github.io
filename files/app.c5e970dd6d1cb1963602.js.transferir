   * To check if the marker is visible in current viewport
   * @returns Array
   */
  getTrueVisiblePois: function getTrueVisiblePois() {
    var contained = [];
    var bounds = maplibregl_Map.getInstance().getBounds();
    this.poiMarkers.forEach(function (pin) {
      if (pin.marker && bounds.contains(pin.marker.getLngLat())) {
        contained.push(pin);
      }
    });
    return contained;
  }
