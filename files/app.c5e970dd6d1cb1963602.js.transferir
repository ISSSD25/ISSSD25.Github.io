    var hcTLD = ['.ae', '.at', '.be', '.ca', '.cat', '.ch', '.cn', '.cz', '.de', '.dk', '.ee', '.es', '.fi', '.fr', '.gr', '.hk', '.ie', '.in', '.it', '.jp', '.lv', '.mx', '.my', '.nl', '.no', '.pe', '.pl', '.pt', '.ru', '.se', '.si', '.sk', '.vn'];
    var hcCoThenTLD = ['.id', '.il', '.kr', '.nz', '.th', '.uk', '.za'];
    var hcComThenTLD = ['.ar', '.au', '.br', '.ec', '.ph', '.sg', '.tr', '.tw'];
    if (hcTLD.indexOf(aTLD) !== -1) {
      return aTLD;
    }
    if (hcCoThenTLD.indexOf(aTLD) !== -1) {
      return ".co".concat(aTLD);
    }
    if (hcComThenTLD.indexOf(aTLD) !== -1) {
      return ".com".concat(aTLD);
    }
    return undefined;

    // most popular where they have brand
    // KR, AU, NZ, TW, HK, SG, TH, JP, GB, RU,
    // ES, FR, IL, IT
    // Argentina, Mexico, colombia, Peru, Venz:
  }
